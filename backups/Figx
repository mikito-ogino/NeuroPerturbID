def plot_PCA_and_confmat(result):
    # Perform PCA on A_est from results_passive
    pca_data = []
    pca_labels = []

    for group_label in ['A1', 'A2', 'A3', 'A4', 'A5']:
        for A_est in result[group_label]["A_est"]:
            pca_data.append(A_est.flatten())
            pca_labels.append(group_label)

    pca_data = np.array(pca_data)

    # Perform PCA
    pca = PCA(n_components=2)
    pca_results = pca.fit_transform(pca_data)

    # Plot PCA results
    set_default_plot_settings(font_size=24, fig_size=[10,10], dpi=250, 
                              line_color='blue',axes_limit=(-2,2),line_width=1)
    for label, color in zip(['A1', 'A2', 'A3', 'A4', 'A5'], ['red', 'blue', 'green', 'purple', 'orange']):
        indices = [i for i, l in enumerate(pca_labels) if l == label]
        plt.scatter(pca_results[indices, 0], pca_results[indices, 1], label=label, color=color, alpha=0.6)

    plt.title('PCA Visualization of A_est from Passive Results')
    plt.xlabel('PCA Dimension 1')
    plt.ylabel('PCA Dimension 2')
    plt.legend()
    plt.grid(alpha=0.3)
    plt.tight_layout()

    # Save the PCA plot
    pca_filename = os.path.join(results_dir, f"{__file__.split('/')[-1].split('.')[0]}_passive_A_est_pca_plot.svg")
    plt.savefig(pca_filename)
    print(f"Figure saved as {pca_filename}")
    plt.show()

    # Prepare data for classification
    data = np.array(flattened_A1 + flattened_A2 + flattened_A3 + flattened_A4 + flattened_A5)
    labels = np.array(['A1'] * len(flattened_A1) + 
                    ['A2'] * len(flattened_A2) + 
                    ['A3'] * len(flattened_A3) + 
                    ['A4'] * len(flattened_A4) + 
                    ['A5'] * len(flattened_A5))

    # Train a classifier with 10-fold cross-validation
    clf = LinearDiscriminantAnalysis()
    predicted_labels = []
    true_labels = []

    # Perform 10-fold cross-validation
    for train_index, test_index in KFold(n_splits=10, shuffle=True, random_state=42).split(data):
        X_train, X_test = data[train_index], data[test_index]
        y_train, y_test = labels[train_index], labels[test_index]

        # Train the classifier
        clf.fit(X_train, y_train)

        # Predict on the test set
        y_pred = clf.predict(X_test)

        # Collect predictions and true labels
        predicted_labels.extend(y_pred)
        true_labels.extend(y_test)

    # Calculate and print the mean accuracy
    mean_accuracy = np.mean(np.array(predicted_labels) == np.array(true_labels))
    print(f"10-Fold Cross-Validation Accuracy: {mean_accuracy:.2%}")

    # Compute confusion matrix
    cm = confusion_matrix(true_labels, predicted_labels, labels=['A1', 'A2', 'A3', 'A4', 'A5'])

    # Plot the confusion matrix
    disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=['A1', 'A2', 'A3', 'A4', 'A5'])
    disp.plot(cmap=plt.cm.Blues)
    plt.title(f"Confusion Matrix (10-Fold CV Accuracy: {mean_accuracy:.2%})")
    plt.tight_layout()
    plt.show()
    
